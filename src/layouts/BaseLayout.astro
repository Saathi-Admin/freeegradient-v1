---
import '@fontsource-variable/host-grotesk/wght.css';
import '../styles/global.css';
import '../styles/skeleton.css';
import BackToTop from '../components/BackToTop.astro';
import { pageSeo } from '../data/seo';
import type { QuestionAnswer } from '../data/answers';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  canonicalPath?: string;
  image?: string;
  pageType?: 'WebPage' | 'CollectionPage' | 'Article';
  items?: {name: string; path: string}[];
  faqs?: QuestionAnswer[];
  artwork?: {name: string; description: string; src: string; colors: string[]};
}
const { title, description = 'Free gradient templates and colour variations.', noindex = false, canonicalPath = Astro.url.pathname, image = '/social/freeegradients.png' } = Astro.props;
const { pageType = 'WebPage', items = [], faqs = [], artwork } = Astro.props;
const {canonical,blockIndex} = pageSeo({site:Astro.site,path:canonicalPath,production:import.meta.env.PROD,noindex,preview:import.meta.env.SEO_PREVIEW});
const socialImage = image && Astro.site ? new URL(image, Astro.site).href : undefined;
const siteId = `${Astro.site?.href}#website`;
const organizationId = `${Astro.site?.href}#organization`;
const schema = canonical && !blockIndex ? {'@context':'https://schema.org','@graph':[
  {'@type':'Organization','@id':organizationId,name:'Arclink Edge',url:'https://www.arclinkedge.com/'},
  {'@type':'WebSite','@id':siteId,name:'FreeeGradients',alternateName:'Freee Gradients',url:Astro.site?.href,inLanguage:'en',publisher:{'@id':organizationId},description:'Free gradient backgrounds for personal and commercial use. Download images or export CSS, HTML and React without signing up.'},
  {'@type':pageType,'@id':`${canonical}#page`,name:title,description,url:canonical,inLanguage:'en',isPartOf:{'@id':siteId},primaryImageOfPage:{'@type':'ImageObject',url:socialImage},...(pageType === 'Article' ? {headline:title,author:{'@type':'Organization',name:'FreeeGradients',url:Astro.site?.href}} : {}),...(items.length ? {mainEntity:{'@type':'ItemList',itemListElement:items.map((item,index)=>({'@type':'ListItem',position:index+1,name:item.name,url:new URL(item.path,Astro.site!).href}))}} : {})},
  ...(faqs.length ? [{'@type':'FAQPage','@id':`${canonical}#faq`,url:canonical,isPartOf:{'@id':`${canonical}#page`},mainEntity:faqs.map(({question,answer})=>({'@type':'Question',name:question,acceptedAnswer:{'@type':'Answer',text:answer}}))}] : []),
  ...(artwork ? [{'@type':'ImageObject','@id':`${canonical}#artwork`,name:artwork.name,description:artwork.description,contentUrl:new URL(artwork.src,Astro.site!).href,url:canonical,encodingFormat:'image/svg+xml',creator:{'@id':organizationId},keywords:artwork.colors.join(', '),isPartOf:{'@id':`${canonical}#page`}}] : []),
  ...(canonicalPath === '/' ? [{'@type':'SiteNavigationElement',name:['Gradients','Collections','Gradient guides','About FreeeGradients'],url:['gradients/','collections/','guides/','about/'].map(path=>new URL(path,Astro.site!).href)}] : [])
]} : undefined;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      // Hide unmasked destination content until its own DOM is skeletonized.
      document.documentElement.setAttribute('data-page-loading', '');
      setTimeout(() => document.documentElement.removeAttribute('data-page-loading'), 8000);
    </script>
    <style is:inline>html[data-page-loading] body { visibility: hidden; }</style>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0b" />
    <link rel="icon" href="/favicon/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <meta name="description" content={description} />
    <meta name="robots" content={blockIndex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={pageType === 'Article' ? 'article' : 'website'} />
    <meta property="og:site_name" content="FreeeGradients" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:alt" content={title} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<','\\u003c')} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    <BackToTop />
    <script>import '../scripts/page-loading';</script>
  </body>
</html>
