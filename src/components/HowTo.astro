---
import { Download, Code, Copy, Check } from '@lucide/astro';
const setupCode = '<link rel="stylesheet" href="./gradients/freeegradients.css">\n\n<section class="fg-gradient fg-aurora-01">\n  Your next idea\n</section>';
const steps = [
  { number: '01', icon: '/layers.png', title: 'Find your gradient.', text: 'Explore the collections or browse all gradients. Choose a style that fits your next idea.' },
  { number: '02', icon: '/color.png', title: 'Pick your colours.', text: 'Open a gradient and choose a colour variation. Find the right match for your light or dark design.' },
  { number: '03', icon: '/download.png', title: 'Copy or download.', text: 'Copy CSS for your website, or download SVG, PNG or JPEG for your design. Ready when you are.' },
];
---
<section id="how-to-use" class="section container" aria-labelledby="usage-title">
  <div class="section-heading"><h2 id="usage-title">A little colour.<br /><span class="text-serif-italic">A lot of possibilities.</span></h2><p class="text-body-md">Three simple steps. Your next background is ready.</p></div>
  <div class="usage-steps">
    {steps.map(({ number, icon, title, text }) => <article class="usage-step">
      <div class="usage-step-top"><img class="usage-icon" src={icon} alt="" width="48" height="48" loading="lazy" decoding="async" /><span class="text-caption usage-number">{number}</span></div>
      <div class="usage-step-copy"><h3 class="text-h6">{title}</h3><p class="text-body-sm">{text}</p></div>
    </article>)}
  </div>
  <div class="usage-library">
    <div class="usage-library-copy"><h3 class="text-h6">All gradients. One download.</h3><p class="text-body-sm">Unzip, link the stylesheet and use a gradient class.</p></div>
    <a class="btn btn-primary btn-md" href="/gradients/freeegradients.zip" download><Download aria-hidden="true" />Download the CSS library</a>
    <div class="usage-example">
      <div class="usage-code-panel">
        <div class="usage-code-header"><span class="text-caption"><Code size={16} aria-hidden="true" />HTML example</span><button class="btn btn-ghost btn-sm" type="button" id="copy-setup-code"><Copy class="setup-copy-icon" size={16} aria-hidden="true" /><Check class="setup-check-icon" size={16} aria-hidden="true" /><span>Copy code</span></button></div>
        <pre><code id="setup-code">{setupCode}</code></pre>
      </div>
    </div>
  </div>
</section>
<style>
  .usage-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--grid-gap); }
  .usage-step, .usage-library { background: var(--surface-card); border-radius: var(--gradient-card-radius); padding: var(--space-12); }
  .usage-step { display: flex; flex-direction: column; gap: var(--space-12); min-width: 0; }
  .usage-step-top { display: flex; align-items: center; justify-content: space-between; gap: var(--space-8); }
  .usage-icon { width: var(--space-24); height: var(--space-24); object-fit: contain; background: transparent; border: 0; border-radius: 0; box-shadow: none; }
  .usage-step .btn, .usage-library .btn { font-size: var(--font-size-14); }
  .usage-number { color: var(--text-muted); }
  .usage-step-copy, .usage-library-copy { display: grid; gap: var(--space-2); }
  .usage-step-copy p, .usage-library-copy p { color: var(--text-secondary); }
  .usage-library { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--space-12); margin-top: var(--space-12); }
  .usage-example { grid-column: 1 / -1; min-width: 0; display: grid; grid-template-columns: minmax(0, 1fr); }
  .usage-code-panel { background: var(--surface-canvas); border-radius: var(--gradient-card-image-radius); padding: var(--space-8); min-width: 0; display: grid; gap: var(--space-8); }
  .usage-code-header { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .usage-code-header > span { display: flex; align-items: center; gap: var(--space-4); color: var(--text-muted); }
  .usage-example pre { background: transparent; border-radius: 0; padding: 0; white-space: pre-wrap; overflow-wrap: anywhere; overflow-x: hidden; }
  .setup-check-icon, [data-copied] .setup-copy-icon { display: none; }
  [data-copied] .setup-check-icon { display: block; }
  @media (max-width: 799px) { .usage-steps { grid-template-columns: 1fr; } .usage-library { grid-template-columns: minmax(0, 1fr); } .usage-library > .btn { justify-self: start; } }
  @media (max-width: 799px) { .usage-example { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 479px) { .usage-step, .usage-library { padding: var(--space-8); } .usage-library > .btn { width: 100%; font-size: var(--font-size-14); } }
</style>
<script>
  const copyButton = document.querySelector<HTMLButtonElement>('#copy-setup-code');
  const code = document.querySelector<HTMLElement>('#setup-code');
  const notify = (message: string) => document.dispatchEvent(new CustomEvent('library-notify', { detail: message }));
  let resetTimer: ReturnType<typeof setTimeout>;
  copyButton?.addEventListener('click', async () => {
    if (!code) return;
    try {
      await navigator.clipboard.writeText(code.textContent ?? '');
      copyButton.dataset.copied = '';
      copyButton.querySelector('span')!.textContent = 'Copied';
      notify('HTML example copied.');
      clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        delete copyButton.dataset.copied;
        copyButton.querySelector('span')!.textContent = 'Copy code';
      }, 3000);
    } catch {
      const selection = window.getSelection();
      const range = document.createRange();
      range.selectNodeContents(code);
      selection?.removeAllRanges();
      selection?.addRange(range);
      notify('Select and copy the highlighted code.');
    }
  });
</script>
