---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary' | 'outline' | 'ghost' | 'brand';
type Props = HTMLAttributes<'button'> & {
  variant?: Variant;
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
  iconOnly?: boolean;
  href?: string;
  rel?: string;
};

const {
  variant = 'primary',
  size = 'md',
  iconOnly = false,
  class: className,
  type = 'button',
  href,
  ...attributes
} = Astro.props;
const Tag = href ? 'a' : 'button';
if (iconOnly && !attributes['aria-label'] && !attributes['aria-labelledby']) {
  throw new Error('Icon-only buttons need aria-label or aria-labelledby.');
}
---
<Tag type={href ? undefined : type} href={href} class:list={['btn', `btn-${variant}`, `btn-${size}`, { 'btn-icon': iconOnly }, className]} {...attributes}>
  <slot name="leading-icon" />
  <slot />
  <slot name="trailing-icon" />
</Tag>
