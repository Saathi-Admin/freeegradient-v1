---
import { questions } from '../data/answers';
---
<section id="faq" class="section container faq-section" aria-labelledby="faq-title">
  <div class="section-heading faq-heading">
    <h2 id="faq-title">Frequently asked questions.</h2>
    <p class="text-body-md">A little help with your next background.</p>
  </div>
  <div class="faq-list">
    {questions.map(({ question, answer }) => <details class="faq-item">
      <summary class="text-body-md"><span>{question}</span><span class="faq-toggle-icon" aria-hidden="true"></span></summary>
      <div class="faq-answer text-body-md"><p>{answer}</p></div>
    </details>)}
  </div>
</section>
<style>
  .faq-heading { text-align: center; }
  .faq-list { display: grid; gap: var(--space-4); max-width: 800px; margin-inline: auto; }
  .faq-item { background: var(--surface-card); border-radius: var(--space-12); overflow: hidden; }
  .faq-item summary { display: flex; align-items: center; justify-content: space-between; gap: var(--space-8); padding: var(--space-12); cursor: pointer; list-style: none; color: var(--text-primary); font-weight: var(--font-weight-medium); }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary:focus-visible { outline-offset: -3px; border-radius: var(--space-12); }
  .faq-toggle-icon { position: relative; width: 20px; height: 20px; flex: 0 0 20px; color: var(--text-secondary); }
  .faq-toggle-icon::before, .faq-toggle-icon::after { content: ''; position: absolute; inset: 9px 3px; height: 2px; border-radius: var(--radius-full); background: currentColor; }
  .faq-toggle-icon::after { transform: rotate(90deg); transition: transform 240ms ease, opacity 240ms ease; }
  .faq-item[open] .faq-toggle-icon::after { transform: rotate(0deg); opacity: 0; }
  @media (prefers-reduced-motion: reduce) { .faq-toggle-icon::after { transition: none; } }
  .faq-answer { padding: 0 var(--space-12) var(--space-12); color: var(--text-secondary); overflow-wrap: anywhere; }
  @media (max-width: 639px) { .faq-item summary { padding: var(--space-8); } .faq-answer { padding: 0 var(--space-8) var(--space-8); } }
</style>
