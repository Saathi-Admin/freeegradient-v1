---
import Button from "./ui/Button.astro";
import { X, Code, Download } from "@lucide/astro";
---
  <dialog class="gradient-dialog" aria-labelledby="dialog-title">
    <div class="dialog-header"><div><h2 class="text-h5" id="dialog-title"></h2><p class="text-caption" id="dialog-id"></p></div><Button size="sm" variant="secondary" iconOnly aria-label="Close preview" id="close-preview"><X aria-hidden="true" /></Button></div>
    <div class="dialog-preview"><img id="dialog-image" alt="" width="1600" height="900" /><div class="preview-copy" id="preview-copy"><p class="text-caption">YOUR NEXT IDEA</p><p class="text-h2">Make something<br /><span class="text-serif-italic">beautiful.</span></p></div></div>
    <div class="palette-row"><div class="swatches" id="dialog-palettes"></div><span class="text-caption" id="dialog-palette-name"></span></div>
    <div class="dialog-actions"><Button size="sm" variant="primary" data-export="css"><Code slot="leading-icon" aria-hidden="true" />Copy CSS</Button><Button size="sm" variant="secondary" data-export="svg"><Download slot="leading-icon" aria-hidden="true" />SVG</Button><Button size="sm" variant="secondary" data-export="png"><Download slot="leading-icon" aria-hidden="true" />PNG</Button><Button size="sm" variant="secondary" data-export="jpeg"><Download slot="leading-icon" aria-hidden="true" />JPEG</Button></div>
    <p class="dialog-note text-caption" id="dialog-note"></p>
  </dialog>
  <div class="toast" role="status" aria-live="polite" hidden></div>
