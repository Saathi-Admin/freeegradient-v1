---
import BaseLayout from '../layouts/BaseLayout.astro';
import Select from './ui/Select.astro';
import Button from './ui/Button.astro';
import SearchField from './ui/SearchField.astro';
import { gradients } from '../data/gradients';
import TabBar from './ui/TabBar.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import GradientCard from './GradientCard.astro';
import GradientPreview from './GradientPreview.astro';
import { Sun, Moon, ArrowLeft, ArrowRight } from '@lucide/astro';
import { collections } from '../data/collections';
import type { GradientTemplate } from '../types/gradient';
import { gradientResults, gradientPageSize, gradientPageUrl, type BrowseMode } from '../data/gradient-pages';
import '../styles/library.css';
import '../styles/content-cards.css';
import { collectionContent } from '../data/collection-content';
import { guides } from '../data/guides';
import { guideCardVariation } from '../data/guide-cards';
interface Props { mode?: BrowseMode; page?: number; category?: GradientTemplate['category']; }
const { mode = 'all', page = 1, category } = Astro.props;
const collection = collections.find(c=>c.id===category);
const results = gradientResults(mode,category);
const pageCount = Math.ceil(results.length / gradientPageSize);
const start = (page - 1) * gradientPageSize;
const cards = results.slice(start, start + gradientPageSize);
const templates = [...new Map(cards.map(card => [card.gradient.slug, card.gradient])).values()];
const title = collection?.title ?? 'All gradients';
const searchTitles: Record<string,string> = {floral:'Floral Blur',liquid:'Liquid Glass',studies:'Abstract Colour',landing:'Landing Page',smooth:'Smooth',mesh:'Mesh',glow:'Glow and Aurora',vintage:'Grain and Vintage',waves:'Wave',footer:'Footer',sunset:'Sunset',pastel:'Pastel',holographic:'Holographic',cosmic:'Cosmic',prism:'Prism and Glass',duotone:'Duotone',angular:'Conic',spotlight:'Spotlight',earth:'Earth Tone'};
const seoTitle = category ? `Free ${category === 'halo-horizons' ? 'Halo Horizon' : category === 'colour-clouds' ? 'Colour Cloud' : (searchTitles[category] ?? collection?.title ?? category)} Gradient Backgrounds` : 'Free CSS Gradient Backgrounds';
const pageUrl = (selectedMode: BrowseMode, selectedPage=1) => gradientPageUrl(selectedMode, selectedPage, category);
const content = category ? collectionContent[category] : undefined;
const guide = guides.find(g=>g.slug===(content?.guide ?? 'gradient-styles-explained'))!;
const adviceGuides = [guide,...guides.filter(g=>['gradient-export-formats','readable-text-on-gradients'].includes(g.slug) && g.slug!==guide.slug)];
---
<BaseLayout pageType="CollectionPage" items={cards.map(({gradient}) => ({name:gradient.name,path:`/gradients/${gradient.variations[0].id}/`}))} title={`${seoTitle}${page > 1 ? ` — Page ${page}` : ''}${mode !== 'all' ? ` — For ${mode} designs` : ''} | FreeeGradients`} noindex={mode !== 'all'} description={collection ? `${collection.description} Copy free ${collection.title.toLowerCase()} CSS gradients or download SVG, PNG and JPEG backgrounds.${page > 1 ? ` Page ${page}.` : ""}` : `Browse free CSS gradients and SVG backgrounds for light and dark designs. Copy CSS or download PNG and JPEG for personal and commercial use.${page > 1 ? ` Page ${page}.` : ""}`}>
  <Header />
  <main id="main-content" class="collection-detail container">
    <div class="collection-detail-hero">
      <Breadcrumbs items={collection ? [{label:'Home',href:'/'},{label:'Collections',href:'/collections/'},{label:collection.title}] : [{ label: 'Home', href: '/' }, { label: 'All gradients' }]} />
      <div class="collection-detail-intro">
        <h1 id="all-gradients-title"><span class="hero-heading-neutral">{title}{!collection && '.'}</span></h1>
        <p class="hero-description text-body-md">{collection?.description ?? 'Every style. Every colour. Find your next background, copy the CSS or download SVG, PNG and JPEG. Completely free.'}</p>
        <TabBar label="Filter gradients by design background">
          <a class="btn btn-ghost btn-sm" href={pageUrl('all')} aria-current={mode === 'all' ? 'page' : undefined}>All</a>
          <a class="btn btn-ghost btn-sm" href={pageUrl('light')} aria-current={mode === 'light' ? 'page' : undefined}><Sun aria-hidden="true" />For light</a>
          <a class="btn btn-ghost btn-sm" href={pageUrl('dark')} aria-current={mode === 'dark' ? 'page' : undefined}><Moon aria-hidden="true" />For dark</a>
        </TabBar>

      </div>
    </div>
    <section aria-labelledby="all-gradients-title">
      <div class="listing-toolbar">
      <p class="browse-count text-caption" id="browse-count">{start + 1}–{start + cards.length} of {results.length} colour variations</p>
        <div class="gradient-search-controls" data-gradient-search data-mode={mode} data-category={category ?? 'all'}>
          <SearchField class="gradient-search-field" id="gradient-search" label="Search gradient templates" placeholder="Search templates, colours or styles…" />
          {!category && <Select id="gradient-category" label="Filter by collection" pill options={[{value:'all',label:'All collections'},...collections.map(c=>({value:c.id,label:c.title}))]} value="all" />}
          <Select id="gradient-colour" label="Filter by colour" pill options={[{value:'all',label:'All colours'},...['blue','red','green','pink','purple','orange','yellow','mint','jade','rose','peach','lavender'].map(colour=>({value:colour,label:colour[0].toUpperCase()+colour.slice(1)}))]} value="all" />
        </div>
      </div>
      <div class="grid" id="browse-grid">{cards.map(({gradient,variation},order) => <GradientCard gradient={gradient} variationId={variation.id} designMode={variation.mode} order={order} featured />)}</div>
      <div class="grid" id="search-grid" hidden></div>
      <p class="text-body-sm search-status" id="gradient-search-status" role="status" hidden></p>
      <nav class="browse-pagination" id="browse-pagination" aria-label="Gradient pages">
        <Button variant="secondary" size="md" href={page > 1 ? pageUrl(mode, page - 1) : undefined} rel={page > 1 ? 'prev' : undefined} disabled={page <= 1 ? true : undefined}><ArrowLeft slot="leading-icon" aria-hidden="true" />Previous</Button>
        <Select id="browse-page" label="Choose page" pill options={Array.from({length:pageCount},(_,i)=>({value:pageUrl(mode,i+1),label:`Page ${i+1}`}))} value={pageUrl(mode,page)} valueLabel={`Page ${page} of ${pageCount}`} />
        <Button variant="secondary" size="md" href={page < pageCount ? pageUrl(mode, page + 1) : undefined} rel={page < pageCount ? 'next' : undefined} disabled={page >= pageCount ? true : undefined}>Next<ArrowRight slot="trailing-icon" aria-hidden="true" /></Button>
      </nav>
      <nav class="browse-pagination" id="search-pagination" aria-label="Search result pages" hidden>
        <Button variant="secondary" size="md" id="search-prev"><ArrowLeft slot="leading-icon" aria-hidden="true" />Previous</Button>
        <Select id="search-page" label="Choose search results page" pill options={Array.from({length:Math.ceil(gradients.length/24)},(_,i)=>({value:String(i+1),label:`Page ${i+1}`}))} value="1" />
        <Button variant="secondary" size="md" id="search-next">Next<ArrowRight slot="trailing-icon" aria-hidden="true" /></Button>
      </nav>
      <div id="library-empty" hidden></div>
    </section>
    {page === 1 && mode === 'all' && <section class="collection-advice" aria-labelledby="collection-advice-title">
      <div class="section-heading collection-advice-heading">
        <h2 class="text-h3" id="collection-advice-title">{collection ? `How to use ${seoTitle.replace('Free ','').toLowerCase()}` : 'How to find and use a free gradient background'}</h2>
        <p class="text-body-md">{content?.summary ?? 'Browse by style, filter by colour and compare light and dark variations. Open any gradient to see its palette, copy its CSS or export an image. Every background is free for personal and commercial projects, with no account required.'}</p>
        {content && <p class="text-body-md">{content.tip}</p>}
        <p class="text-body-md">Choose CSS for a website background or export PNG, JPG, SVG or WebP for your project. The exporter includes Full HD, 4K, square, story and phone presets, plus custom sizes. Some SVG designs contain raster artwork; output dimensions do not increase their source detail.</p>
      </div>
      <nav class="collection-advice-grid" aria-label="Learn about these gradients">{adviceGuides.map(g=>{
        const variation = guideCardVariation(g.slug);
        const background = variation.cssKind === 'native' ? variation.css : `url("${variation.backgroundSrc ?? variation.src}")`;
        return <a class="content-card" href={`/guides/${g.slug}/`} data-mode={variation.mode} style={`--card-gradient: ${background}`}><h3 class="text-h4">{g.title}</h3></a>;
      })}</nav>
    </section>}
  </main>
  <Footer />
  <GradientPreview templates={templates} />
  <script>import '../scripts/library';</script>
  <script>import '../scripts/gradient-search'; document.querySelector('#browse-page')?.addEventListener('select-change',event=>{location.href=(event as CustomEvent).detail.value;});</script>
</BaseLayout>
<style>
  .collection-advice { margin-top: var(--space-32); }
  .collection-advice-heading { max-width: 880px; margin-inline: auto; }
  .collection-advice-heading p { color: var(--text-secondary); }
  .collection-advice-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-8); }
  .listing-toolbar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-12); margin-bottom: var(--space-12); }
  .browse-count { margin: 0; color: var(--text-secondary); flex-shrink: 0; }
  .browse-pagination { display: flex; justify-content:center; gap: var(--space-4); align-items: center; margin-top: var(--space-16); }
  .browse-pagination :global(.custom-select) { width:160px; }
  .browse-pagination[hidden] { display:none; }
  .gradient-search-controls { --search-width: calc(var(--space-64) * 2.5); display: flex; justify-content: flex-end; gap: var(--space-4); min-width: 0; }
  .gradient-search-controls :global(.gradient-search-field) { flex: 0 1 var(--search-width); width: var(--search-width); min-width: 0; }
  .gradient-search-controls :global(.custom-select) { width:190px; }
  .search-status { color: var(--text-secondary); margin-top: var(--space-12); }
  #search-grid :global(.gradient-card) { color: var(--text-primary); text-decoration: none; cursor: pointer; }
  #search-grid :global(.card-media img) { display: block; width: 100%; height: auto; aspect-ratio: var(--gradient-aspect-ratio); object-fit: cover; border-radius: var(--gradient-card-image-radius); }
  @media (max-width: 899px) {
    .listing-toolbar { flex-direction: column; align-items: stretch; gap: var(--space-8); }
    .gradient-search-controls { width: 100%; }
  }
  @media (max-width: 639px) {
    .collection-advice-grid { grid-template-columns: 1fr; }
    .gradient-search-controls { flex-wrap: wrap; }

    .gradient-search-controls :global(.gradient-search-field) { flex: 1 1 120px; width: auto; min-width: 0; }
    .gradient-search-controls :global(.custom-select) { flex: 0 0 140px; width: 140px; }
    .gradient-search-controls[data-category="all"] :global(.gradient-search-field) { flex-basis: 100%; width: 100%; }
    .gradient-search-controls[data-category="all"] :global(.custom-select) { flex: 1 1 0; width: auto; }
  }
  @media (max-width: 479px) { .browse-pagination :global(.custom-select) { width:140px; } }
</style>
