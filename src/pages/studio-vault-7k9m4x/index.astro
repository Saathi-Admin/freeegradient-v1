---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Review admin · FreeeGradients" noindex={true}>
  <main id="main-content" class="admin-shell">
    <header class="admin-header"><a href="/">freeegradients.</a><div class="admin-header-actions"><button id="refresh" class="btn btn-secondary">Refresh</button><button id="logout" class="btn btn-secondary" hidden>Sign out</button></div></header>
    <section id="login-panel" class="admin-login admin-card">
      <h1>Welcome back.</h1><p>Sign in to manage community reviews.</p>
      <form id="admin-login">
        <input name="username" aria-label="Username" placeholder="Username" autocomplete="username" required maxlength="80" />
        <input name="password" type="password" aria-label="Password" placeholder="Password" autocomplete="current-password" required maxlength="1024" />
        <button class="btn btn-primary" type="submit">Sign in</button>
      </form>
    </section>
    <section id="dashboard" hidden>
      
      <nav class="admin-filters" aria-label="Filter reviews">{['all','pending','approved','rejected','hidden','removed'].map(status=><button data-status={status} aria-pressed={status==='all'}><span>{status.charAt(0).toUpperCase()+status.slice(1)}</span><strong data-count={status}>0</strong></button>)}</nav>
      <form id="admin-search" role="search"><input name="search" type="search" placeholder="Search name, email or review…" aria-label="Search reviews" maxlength="100" /></form>
      <div id="reviews" class="admin-reviews" aria-live="polite"></div>
      <div class="admin-pagination"><button id="previous" class="btn btn-secondary">Previous</button><span id="page-info"></span><button id="next" class="btn btn-secondary">Next</button></div>
    </section>
    <p id="admin-message" role="status" hidden></p>
  </main>
  <script>import '../../scripts/admin';</script>
</BaseLayout>
<style is:global>
  .admin-shell { width:min(1120px,calc(100% - 40px));margin:0 auto;padding:32px 0 80px; }
  .admin-shell [hidden] { display:none!important; }
  .admin-header,.admin-heading,.admin-pagination { display:flex;align-items:center;justify-content:space-between;gap:20px; }
  .admin-header { margin-bottom:72px; }.admin-header>a { font-size:24px;font-weight:650;text-decoration:none;color:var(--text-primary); }.admin-header>span { color:var(--text-muted);margin-right:auto; }
  .admin-shell h1 { font-family:inherit;font-size:clamp(28px,4vw,40px);line-height:1.2;margin:10px 0 14px; }.admin-shell p { color:var(--text-secondary); }.admin-shell .eyebrow { font-size:11px;letter-spacing:.14em; }
  .admin-card { background:var(--surface-card);border:1px solid var(--border-subtle);border-radius:28px;padding:28px; }
  .admin-login { max-width:440px;margin:0 auto; }.admin-login form { display:grid;gap:14px;margin-top:28px; }
  .admin-shell input { min-width:0;width:100%;height:48px;border-radius:999px;padding:0 20px;border:1px solid var(--border-subtle);background:var(--surface-canvas);color:var(--text-primary);font:inherit; }
  .admin-shell input:focus-visible,.admin-filters button:focus-visible { outline:2px solid var(--focus-ring);outline-offset:3px; }
  .admin-filters { display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin:32px 0 20px; }.admin-filters button { display:flex;align-items:center;justify-content:space-between;gap:12px;padding:20px;border-radius:20px;background:var(--surface-card);border:1px solid var(--border-subtle);color:var(--text-secondary);font:inherit;cursor:pointer; }.admin-filters button[aria-pressed=true] { border-color:var(--text-secondary);color:var(--text-primary);background:var(--surface-raised); }.admin-filters strong { font-size:24px; }
  #admin-search { display:flex;gap:12px;margin-bottom:24px; }#admin-search input { background:var(--surface-card); }
  .admin-reviews { display:grid;gap:16px; }.admin-review-head { display:flex;justify-content:space-between;gap:16px;align-items:start; }.admin-review-head h2 { font-size:18px;line-height:1.4; }.admin-review-meta { font-size:13px;overflow-wrap:anywhere; }.admin-review-stars { color:#efc779;letter-spacing:3px;margin:16px 0 8px; }.admin-review-body { white-space:pre-wrap;overflow-wrap:anywhere;color:var(--text-primary)!important;line-height:1.7; }.admin-review-actions { display:flex;flex-wrap:wrap;gap:10px;margin-top:22px; }.admin-badge { border-radius:999px;padding:5px 12px;background:var(--surface-raised);font-size:12px;text-transform:capitalize; }.admin-badge[data-state=pending] { color:#efc779; }.admin-badge[data-state=approved] { color:#90d8af; }.admin-badge[data-state=rejected] { color:#efa5a5; }.admin-review-date { font-size:12px;margin-top:12px; }.admin-pagination { justify-content:center;margin-top:28px; }#page-info { font-size:14px;color:var(--text-secondary); }#admin-message { margin:24px auto;max-width:760px;text-align:center;color:#efc779; }.admin-empty { padding:60px 24px;text-align:center;border:1px dashed var(--border-subtle);border-radius:24px; }
  @media(max-width:639px) { .admin-header { margin-bottom:40px;flex-wrap:wrap; }.admin-header>span { display:none; }.admin-heading { align-items:start; }.admin-filters { grid-template-columns:repeat(2,1fr); }.admin-card { padding:22px; }.admin-filters button { padding:16px; }#admin-search { flex-wrap:wrap; }#admin-search input { flex:1 1 200px; }.admin-review-head { flex-wrap:wrap; } }
  .admin-filters button > span, .admin-filters button > strong { display: flex; align-items: center; min-height: 32px; line-height: 1; margin: 0; }
  .admin-login > h1 { margin-top: 0; }
  .admin-filters button { flex-direction: column; justify-content: center; align-items: flex-start; gap: 12px; text-align: left; }
  .admin-header-actions { display: flex; align-items: center; gap: 12px; margin-left: auto; } .admin-shell:has(#dashboard[hidden]) #refresh { display: none; }
</style>
