---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Faq from '../components/Faq.astro';
import Testimonials from '../components/Testimonials.astro';
import { questions } from '../data/answers';
import HowTo from '../components/HowTo.astro';
import PlaygroundShowcase from '../components/PlaygroundShowcase.astro';
import Header from '../components/Header.astro';
import GradientCard from '../components/GradientCard.astro';
import CollectionCard from '../components/CollectionCard.astro';
import GradientPreview from '../components/GradientPreview.astro';
import { collections } from '../data/collections';
import Button from '../components/ui/Button.astro';
import { ArrowUpRight } from '@lucide/astro';
import { gradients } from '../data/gradients';
import '../styles/library.css';
const featuredCollections = collections.slice(0, 7);
const collectionPreview = collections.slice(0, 6);
const heroCollections = ['landing', 'colour-clouds', 'fluid-fields', 'prismatic-light'].map(id => collections.find(collection => collection.id === id)!);
const gradientTotal = new Set(gradients.flatMap(template => template.variations.map(variation => variation.id))).size;
const gradientCount = gradientTotal.toLocaleString('en-US');
const gradientMilestone = gradientTotal >= 1000 ? `${Math.floor(gradientTotal / 1000) * 1000}+` : gradientCount;
const heroTemplate = gradients.find(template => template.slug === 'refracted-saddle')!;
const heroVariation = heroTemplate.variations.find(variation => variation.name === 'Cobalt signal')!;
const heroBackground = `url("${heroVariation.backgroundSrc ?? heroVariation.src}")`;
const featuredGradients = gradients.filter(g => ['velvet','daybreak','tideline','orbit','bloom','nectar','halo','aurora','ember','analogue','haze','film','ripple','drift','flux','horizon','dawnlight','atmosphere','afterglow','uplift','nightfall'].includes(g.slug) || ['tech-atmospheres', 'colour-clouds', 'fluid-fields', 'prismatic-light'].includes(g.category));
const allGradientCards = collections.slice(0, 6).map((collection, index) => {
  const mode = index % 2 === 0 ? 'dark' : 'light';
  const gradient = gradients.find(template => template.category === collection.id && template.variations.some(item=>item.mode===mode)) ?? gradients.find(template=>template.category===collection.id)!;
  const variation = gradient.variations.find(item => item.mode === mode) ?? gradient.variations[0];
  return { gradient, variation };
});
const homePreviewTemplates = [...new Map([...featuredGradients, ...allGradientCards.map(card => card.gradient)].map(template => [template.slug, template])).values()];
---
<BaseLayout faqs={questions} title={`${gradientCount} Free CSS Gradients for Personal & Commercial Use | FreeeGradients`} description={`Explore ${gradientCount} free gradient backgrounds for personal and commercial use. Copy CSS or download SVG, PNG and JPEG. No sign-up. No download limits.`}>
  <Header hero />
  <main id="main-content" class="homepage-main" style={`--hero-gradient: ${heroBackground}`}>
    <div class="homepage-hero">
    <section class="hero container" id="gradients" aria-labelledby="hero-title">
      <div class="hero-intro">
      <div class="hero-copy">
        <div class="hero-eyebrow hero-format-chip text-caption">
          <div class="hero-format-list" role="group" aria-label="Available formats">
            {['.css', '.svg', '.png', '.jpeg'].map((format, index) => <span class="hero-format-item" style={`--format-gradient:var(--gradient-format-${index + 1})`}>{format}</span>)}
          </div>
        </div>
        <h1 id="hero-title"><span class="hero-heading-neutral">{gradientMilestone} gradients <span class="text-serif-italic">free</span><span class="hero-for-desktop"> for</span></span><br /><span class="hero-heading-neutral"><span class="hero-for-mobile">for </span><span class="text-serif-italic">personal</span> and <span class="hero-commercial"><span class="text-serif-italic">commercial</span> use.</span></span></h1>
        <p class="hero-description text-body-md">Free gradient backgrounds for personal and commercial use. Copy CSS or download SVG, PNG and JPEG. No sign-up. No download limits.</p>
      </div>
      </div>
      <div class="collection-grid">{heroCollections.map(collection => {
        const templates = gradients.filter(g => g.category === collection.id);
        return <CollectionCard id={collection.id} title={collection.title} preview={collection.preview} variations={templates.reduce((count, template) => count + template.variations.length, 0)} />;
      })}</div>
      <div class="section-link"><a class="btn btn-md hero-collections-cta" href="/collections/">Explore all collections <ArrowUpRight aria-hidden="true" /></a></div>
    </section>
    </div>
    <section class="section container" id="all-gradients" aria-labelledby="all-gradients-title">
      <div class="section-heading"><h2 id="all-gradients-title">All gradients</h2><p class="text-body-md">A little of every style. Find the colours for your next idea.</p></div>
      <div class="grid all-gradient-grid">
        {allGradientCards.map(({ gradient, variation }, order) => <GradientCard gradient={gradient} variationId={variation.id} order={order} />)}
      </div>
      <div class="section-link"><a class="btn btn-secondary btn-md" href="/gradients/">Explore all gradients <ArrowUpRight aria-hidden="true" /></a></div>
    </section>
    <PlaygroundShowcase />
    <div id="collections" class="container">
      {featuredCollections.map(collection => <section class="section collection" data-category={collection.id} id={collection.id} aria-labelledby={`${collection.id}-title`}>
        <div class="section-heading"><h2 id={`${collection.id}-title`}>{collection.title}</h2><p class="text-body-md">{collection.description}</p></div>
        <div class="grid">{(['dark', 'light'] as const).flatMap(designMode => featuredGradients.filter(g => g.category === collection.id && g.variations.some(v=>v.mode===designMode)).slice(0, 3).map((gradient, order) => <GradientCard gradient={gradient} order={order} designMode={designMode} />))}</div>
        <div class="section-link"><a class="btn btn-secondary btn-md" href={`/collections/${collection.id}/`} aria-label={`Explore ${collection.title}`}>Explore the collection <ArrowUpRight aria-hidden="true" /></a></div>
      </section>)}
      <div class="empty-state" id="library-empty" hidden><p>No gradients for this mode yet. Try another design background.</p><Button variant="secondary" size="sm" id="clear-filters">Clear filters</Button></div>
    </div>
    <section class="section container" id="all-collections" aria-labelledby="all-collections-title">
      <div class="section-heading"><h2 id="all-collections-title">All collections</h2><p class="text-body-md">Explore every style. Find a collection for your next idea.</p></div>
      <div class="collection-grid collections-list-grid">
        {collectionPreview.map(collection => {
          const variations = gradients.filter(template => template.category === collection.id).reduce((count, template) => count + template.variations.length, 0);
          return <CollectionCard id={collection.id} title={collection.title} preview={collection.preview} variations={variations} />;
        })}
      </div>
      <div class="section-link"><Button variant="secondary" size="md" href="/collections/">Explore all collections<ArrowUpRight slot="trailing-icon" aria-hidden="true" /></Button></div>
    </section>
    <HowTo />
    <Testimonials />
    <Faq />
  </main>
  <Footer />
  <GradientPreview templates={homePreviewTemplates} />
  <script>
    import '../scripts/library';
  </script>
</BaseLayout>

<style>
  .homepage-main { position: relative; isolation: isolate; }
  .homepage-hero { background-image: var(--hero-gradient); background-size: cover; background-position: center; background-repeat: no-repeat; }
  .hero {
    --hero-copy-width: 1120px;
    --chip-glass-bg: var(--surface-hero-glass);
    --chip-glass-border: var(--border-hero-glass);
    --chip-glass-shadow: inset 0 1px 0 var(--border-subtle);
    --gradient-format-1: linear-gradient(135deg, #d9fac5, #8ee8ba);
    --gradient-format-2: linear-gradient(135deg, #d7f2ff, #9dcfff);
    --gradient-format-3: linear-gradient(135deg, #ffe2cc, #ffb9b0);
    --gradient-format-4: linear-gradient(135deg, #efe3ff, #cbbaff);
  }
  .hero .hero-format-item { color: #10251e; }
  .hero :global(.collection-card) { background: var(--surface-hero-glass); box-shadow: inset 0 0 0 1px var(--border-hero-glass); }
  .hero :global(.collection-card-footer p) { color: var(--text-secondary); }
  @media (hover: hover) { .hero :global(.collection-card:hover) { background: var(--surface-hero-glass-hover); } }
  .hero-collections-cta { --btn-bg: var(--surface-hero-glass); --btn-border: var(--border-hero-glass); color: var(--text-primary); }
  @media (hover: hover) { .hero-collections-cta:hover:not(:disabled) { --btn-bg: var(--surface-hero-glass-hover); } }
  #hero-title { font-family: var(--font-soul); font-weight: 400; letter-spacing: -0.05556em; }
  .hero .hero-heading-neutral { background-image: linear-gradient(115deg, var(--text-primary) 15%, #d6f7ff 55%, #a4dfff 100%); background-size: 100% 100%; background-clip: text; -webkit-background-clip: text; color: #d6f7ff; -webkit-text-fill-color: transparent; animation: none; filter: none; text-shadow: none; }
  @media (forced-colors: active) { .hero .hero-heading-neutral { background: none; color: CanvasText; -webkit-text-fill-color: CanvasText; } }
  .hero-for-mobile { display: none; }
  @media (max-width: 799px) {
    :is(#all-gradients, .collection) :global(.gradient-card:nth-child(n + 5)),
    #all-collections :global(.collection-card:nth-child(n + 5)) { display: none; }
  }
  @media (max-width: 479px) {
    :is(#all-gradients, .collection) :global(.gradient-card:nth-child(n + 3)),
    :is(.hero, #all-collections) :global(.collection-card:nth-child(n + 3)) { display: none; }
  }
  @media (min-width: 640px) {
    #hero-title { letter-spacing: -3.2px; }
  }
  @media (max-width: 639px) {
    #hero-title { font-size: var(--font-size-40); }
    .hero-for-desktop { display: none; }
    .hero-for-mobile { display: inline; }
    .hero-commercial { display: block; white-space: nowrap; }
  }
</style>


