---
import GradientListing from '../../components/GradientListing.astro';
import { collections } from '../../data/collections';
export function getStaticPaths() {
  return collections.map(collection=>({params:{slug:collection.id},props:{category:collection.id}}));
}
const { category } = Astro.props;
---
<GradientListing category={category} />
