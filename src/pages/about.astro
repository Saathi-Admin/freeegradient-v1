---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { gradients } from '../data/gradients';
import { collections } from '../data/collections';
import '../styles/content-cards.css';
const variationCount = gradients.reduce((count,g)=>count+g.variations.length,0).toLocaleString('en-US');
const exploreLinks = [
  {href:'/gradients/',title:'Browse free gradients',variationId:'refraction-05'},
  {href:'/collections/',title:'Explore collections',variationId:'light-leak-06'},
  {href:'/guides/',title:'Read the gradient guides',variationId:'glassline-08'},
].map(link=>{
  const variation=gradients.flatMap(template=>template.variations).find(v=>v.id===link.variationId)!;
  return {...link,mode:variation.mode,background:variation.cssKind==='native' ? variation.css : `url("${variation.backgroundSrc ?? variation.src}")`};
});
---
<BaseLayout title="About FreeeGradients by Arclink Edge" description="FreeeGradients is a free gradient background library by Arclink Edge. Download artwork or export CSS, HTML and React for personal and commercial projects.">
  <Header /><main id="main-content" class="container about">
    <Breadcrumbs items={[{label:'Home',href:'/'},{label:'About FreeeGradients'}]} />
    <article><h1 class="text-h2">About FreeeGradients</h1>
      <p class="text-body-md">FreeeGradients is a free gradient background library created by <a href="https://www.arclinkedge.com/">Arclink Edge</a> for designers, developers and anyone who needs colour for a project. Use the backgrounds in personal and commercial work, including websites, apps, presentations and client projects.</p>
      <section><h2 class="text-h5">What is in the library?</h2><p>{gradients.length.toLocaleString('en-US')} templates, {variationCount} colour variations and {collections.length} collections. Explore smooth, mesh, grain, glow, pastel, sunset and other styles. A template is a composition; its variations provide different palettes for light and dark designs.</p></section>
      <section><h2 class="text-h5">What can I download?</h2><p>PNG, JPG, SVG and WebP artwork, plus CSS, HTML, React and JSON exports. Image presets include Full HD, 4K, square, social and phone sizes. Custom width and height each range from 64 to 4096 pixels. Downloads require no account and have no download limit.</p></section>
      <section><h2 class="text-h5">How are the backgrounds built?</h2><p>The library includes native CSS gradients and more detailed artwork. Native backgrounds use browser-rendered gradient functions. Detailed compositions use SVG filters, layered shapes or embedded raster artwork, with optimized images for website backgrounds. The source affects scalability and editability; SVG does not always mean that all artwork is vector-based.</p></section>
      <section><h2 class="text-h5">How do I choose a background?</h2><p>Browse a collection, compare colour variations and use the playground to preview a landing page, card, page background or footer. Keep meaningful content as real text and check contrast in the final layout. Our guides explain the export and integration workflows using the features available in the library.</p></section>
      <nav class="about-explore" aria-label="Explore FreeeGradients">{exploreLinks.map(link=><a class="about-explore-card content-card" href={link.href} data-mode={link.mode} style={{'--card-gradient':link.background}}><h2 class="text-h4">{link.title}</h2></a>)}</nav>
    </article>
  </main><Footer />
</BaseLayout>
<style>
  .about { padding-block: var(--header-clearance) var(--section-padding-y); }
  article { max-width: 880px; margin: var(--space-24) auto 0; display: grid; gap: var(--space-12); }
  section { display: grid; gap: var(--space-6); }
  p { color: var(--text-secondary); line-height: 1.7; }
  h1 { line-height: 1.15; }
  a { color: var(--text-primary); }
</style>
<style is:global>
  .about .about-explore { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-8); margin-top: var(--space-8); }
  @media (max-width: 639px) { .about .about-explore { grid-template-columns: 1fr; } }
</style>
