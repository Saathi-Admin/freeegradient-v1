---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GradientPreview from '../../components/GradientPreview.astro';
import Button from '../../components/ui/Button.astro';
import { Code, Download, Sun, Moon, Hash, ArrowUpRight } from '@lucide/astro';
import { gradients } from '../../data/gradients';
import { collections } from '../../data/collections';
import '../../styles/library.css';
export function getStaticPaths() {
  return gradients.flatMap(gradient => gradient.variations.map(variation => ({ params: { id: variation.id }, props: { gradient, variation } })));
}
const { gradient, variation } = Astro.props;
const collection = collections.find(c => c.id === gradient.category)!;

---
<BaseLayout title={`${gradient.name} — ${variation.name} gradient | FreeeGradients`} description={`Download ${variation.name}, a ${variation.mode} ${gradient.name} gradient, free as CSS, SVG, PNG or JPEG. No sign-up required.`}>
  <Header />
  <main id="main-content" class="gradient-detail container">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Collections', href: '/collections/' }, { label: collection.title, href: `/collections/${collection.id}/` }, { label: variation.id }]} />
    <article class="gradient-card gradient-detail-layout" data-template={gradient.slug} data-variation={variation.id} data-fixed-variation={variation.id}>
      <div class="gradient-detail-preview"><img src={variation.src} alt={`${gradient.name}, ${variation.name} gradient`} width="1600" height="900" fetchpriority="high" decoding="async" /></div>
      <div class="gradient-detail-info">
        <div class="gradient-detail-heading">
          <h1 class="text-h2">{gradient.name}</h1>
          <div class="gradient-detail-meta text-caption"><a class="gradient-meta-chip gradient-collection-chip" href={`/collections/${collection.id}/`}>Collection: {collection.title}</a><span class="gradient-meta-chip"><Hash size={14} aria-hidden="true" /><span class="card-id">{variation.id}</span></span><span class="gradient-meta-chip">{variation.mode === 'light' ? <Sun size={14} aria-hidden="true" /> : <Moon size={14} aria-hidden="true" />}For {variation.mode} mode</span></div>
        </div>
        <div class="gradient-detail-colours"><h2 class="text-body-sm gradient-variations-title">More colour variations</h2><div class="gradient-variation-links">{gradient.variations.map(v => <a class="palette-swatch" style={`--swatch:url("${v.src}")`} href={`/gradients/${v.id}/`} aria-label={`${v.name}, ${v.mode} designs`} aria-current={v.id === variation.id ? 'page' : undefined} title={v.name}></a>)}</div></div>
        <div class="gradient-detail-downloads">
          <Button size="md" variant="secondary" data-action="css"><Code slot="leading-icon" aria-hidden="true" />Copy CSS</Button>
          {(['svg', 'png', 'jpeg'] as const).map(format => <Button size="md" variant="secondary" data-action={format}><Download slot="leading-icon" aria-hidden="true" />{format.toUpperCase()}</Button>)}
          <a class="btn btn-primary btn-md gradient-try-layout" href={`/playground/?gradient=${variation.id}`}>Try on a real layout<ArrowUpRight aria-hidden="true" /></a>
        </div>
      </div>
    </article>
    <div id="library-empty" hidden></div>
  </main>
  <Footer />
  <GradientPreview />
  <script>import '../../scripts/library';</script>
</BaseLayout>
