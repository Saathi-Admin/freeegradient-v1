---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GradientPreview from '../../components/GradientPreview.astro';
import GradientCard from '../../components/GradientCard.astro';
import Button from '../../components/ui/Button.astro';
import { Copy, Download, Sun, Moon, Hash, ArrowUpRight } from '@lucide/astro';
import GradientColourMap from '../../components/GradientColourMap.astro';
import { gradients } from '../../data/gradients';
import { collections } from '../../data/collections';
import '../../styles/library.css';
export function getStaticPaths() {
  return gradients.flatMap(gradient => gradient.variations.map(variation => ({ params: { id: variation.id }, props: { gradient, variation } })));
}
const { gradient, variation } = Astro.props;
const collection = collections.find(c => c.id === gradient.category)!;
const primary = gradient.variations[0].id === variation.id;
const related = gradients.filter(g=>g.category===gradient.category && g.slug!==gradient.slug).slice(0,3);

---
<BaseLayout canonicalPath={`/gradients/${gradient.variations[0].id}/`} image={variation.thumbnail} title={primary ? `${gradient.name} CSS Gradient — ${gradient.variations.length} Colour Variations | FreeeGradients` : `${gradient.name} — ${variation.name} gradient | FreeeGradients`} description={primary ? `${gradient.name}: a ${collection.title.toLowerCase()} background with ${gradient.variations.length} light and dark colour variations. Copy CSS, preview a real layout or download SVG, PNG and JPEG. No sign-up.` : `Download ${variation.name}, a ${variation.mode} ${gradient.name} gradient, free as CSS, SVG, PNG or JPEG. No sign-up required.`}>
  <Header playgroundGradient={variation.id} />
  <main id="main-content" class="gradient-detail container">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Collections', href: '/collections/' }, { label: collection.title, href: `/collections/${collection.id}/` }, { label: variation.id }]} />
    <article class="gradient-card gradient-detail-layout" data-template={gradient.slug} data-variation={variation.id} data-fixed-variation={variation.id}>
      <GradientColourMap src={variation.backgroundSrc ?? variation.src} name={gradient.name} palette={variation.name} colors={variation.colors} />
      <div class="gradient-detail-info">
        <div class="gradient-detail-heading">
          <h1 class="text-h2">{gradient.name}</h1>
          <div class="gradient-detail-meta text-caption"><a class="gradient-meta-chip gradient-collection-chip" href={`/collections/${collection.id}/`}>Collection: {collection.title}</a><span class="gradient-meta-chip"><Hash size={14} aria-hidden="true" /><span class="card-id">{variation.id}</span></span><span class="gradient-meta-chip">{variation.mode === 'light' ? <Sun size={14} aria-hidden="true" /> : <Moon size={14} aria-hidden="true" />}For {variation.mode} mode</span></div>
        </div>
        <div class="gradient-detail-colours"><h2 class="text-body-sm gradient-variations-title">More colour variations</h2><div class="gradient-variation-links">{gradient.variations.map(v => <a class="palette-swatch" style={`--swatch:url("${v.thumbnail}")`} href={`/gradients/${v.id}/`} aria-label={`${v.name}, ${v.mode} designs`} aria-current={v.id === variation.id ? 'page' : undefined} title={v.name}></a>)}</div></div>
        <div class="gradient-install">
          <div class="gradient-install-heading"><h2 class="text-body-sm">Use with a class</h2><Button size="sm" variant="secondary" data-copy-stylesheet={gradient.stylesheet}><Copy slot="leading-icon" aria-hidden="true" />Copy stylesheet link</Button></div>
          <button class="gradient-class-copy" type="button" data-copy-class={`fg-gradient fg-${variation.id}`} aria-label={`Copy HTML classes for ${variation.id}`}><code>fg-gradient fg-{variation.id}</code><span class="text-caption"><Copy size={16} aria-hidden="true" />Copy class</span></button>
          <p class="text-caption">Link once in your HTML head. Add these classes to your element.</p>
        </div>
        <div class="gradient-detail-downloads">
          <a class="btn btn-secondary btn-md" href={`/playground/?gradient=${variation.id}`}>Try on a real layout<ArrowUpRight aria-hidden="true" /></a>
          <Button size="md" variant="primary" data-action="export"><Download slot="leading-icon" aria-hidden="true" />Export</Button>
        </div>
      </div>
    </article>
    {related.length > 0 && <section class="gradient-related" aria-labelledby="related-gradients-title">
      <div class="gradient-related-header"><h2 class="text-h5" id="related-gradients-title">More {collection.title.toLowerCase()} gradients</h2><a class="btn btn-ghost btn-sm" href="/guides/use-css-gradients/">How to use CSS gradients<ArrowUpRight aria-hidden="true" /></a></div>
      <div class="gradient-related-grid">{related.map((g,index)=><GradientCard gradient={g} designMode={variation.mode} order={index} />)}</div>
    </section>}
    <div id="library-empty" hidden></div>
  </main>
  <Footer />
  <GradientPreview templates={[gradient,...related]} />
  <script>import '../../scripts/library';</script>
</BaseLayout>
<style>
  .gradient-related { display: grid; gap: var(--space-12); margin-top: var(--space-16); }
  .gradient-related-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-8); }
  .gradient-related-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--grid-gap); }
  @media (max-width: 899px) { .gradient-related-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 479px) { .gradient-related-grid { grid-template-columns: 1fr; } }

  .gradient-install { padding: var(--space-8); border-radius: var(--radius-12); background: var(--surface-card); display: grid; gap: var(--space-4); min-width: 0; }
  .gradient-install-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .gradient-install-heading .btn { font-size: var(--font-size-12); }
  .gradient-class-copy { appearance: none; width: 100%; min-width: 0; border: 0; border-radius: var(--radius-4); background: var(--surface-canvas); color: var(--text-primary); padding: var(--space-6) var(--space-8); cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); text-align: left; }
  .gradient-class-copy code { font-size: var(--font-size-12); overflow-wrap: anywhere; min-width: 0; }
  .gradient-class-copy span { display: flex; align-items: center; gap: var(--space-3); flex-shrink: 0; }
  .gradient-install p { color: var(--text-secondary); }
</style>
