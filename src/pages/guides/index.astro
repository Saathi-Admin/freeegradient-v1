---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import '../../styles/library.css';
import '../../styles/content-cards.css';
import {guides} from '../../data/guides';
import { guideCardVariation } from '../../data/guide-cards';
---
<BaseLayout pageType="CollectionPage" items={guides.map(guide => ({name:guide.title,path:`/guides/${guide.slug}/`}))} title="Free Gradient Guides: CSS, React, 4K & Design Tools | FreeeGradients" description="Choose free gradient backgrounds, compare export formats, download 4K images and use gradients in CSS, React, Tailwind, Figma, Canva and slides.">
<Header />
<main id="main-content" class="collection-detail container guides">
  <div class="collection-detail-hero">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Guides' }]} />
    <div class="collection-detail-intro">
      <h1 id="guides-title"><span class="hero-heading-neutral">Gradient guides.</span></h1>
      <p class="hero-description text-body-md">Choose a background, compare formats and bring your gradient into code, design tools or slides.</p>
    </div>
  </div>
  <div class="guide-grid">
    {guides.map(guide => {
      const variation = guideCardVariation(guide.slug);
      const background = variation.cssKind === 'native' ? variation.css : `url("${variation.backgroundSrc ?? variation.src}")`;
      return <a class="guide-card content-card" href={`/guides/${guide.slug}/`} data-mode={variation.mode} style={`--card-gradient: ${background}`}>
        <h2 class="text-h4">{guide.title}</h2>
      </a>;
    })}
  </div>
</main>
<Footer />
</BaseLayout>
<style>
  .guide-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-8); }
  @media (max-width: 639px) { .guide-grid { grid-template-columns: 1fr; } }
</style>
