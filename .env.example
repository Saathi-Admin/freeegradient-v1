# Set your permanent HTTPS production origin before the production build.
PUBLIC_SITE_URL=https://freeegradients.com

# Your Buy Me a Coffee profile URL enables the footer support button.
PUBLIC_DONATION_URL=

# Review moderation: generate private credentials with npm run admin:setup.
# Production Vercel functions require a Neon Postgres connection string.
DATABASE_URL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
